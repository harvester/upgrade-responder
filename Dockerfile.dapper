FROM alpine:3.18 AS gometalinter-downloader

RUN apk -U add ca-certificates curl tar
RUN mkdir -p /out && \
    curl -fsSL https://github.com/alecthomas/gometalinter/releases/download/v2.0.11/gometalinter-2.0.11-linux-amd64.tar.gz -o /tmp/gometalinter.tar.gz && \
    echo "97d8bd0a4d024740964c7fc2ae41276cf5f839ccf0749528ca900942f656d201  /tmp/gometalinter.tar.gz" | sha256sum -c - && \
    tar --strip-components=1 -xzf /tmp/gometalinter.tar.gz -C /out && \
    rm /tmp/gometalinter.tar.gz

FROM golang:1.15-alpine

RUN apk -U add bash git gcc musl-dev docker vim less file curl wget ca-certificates
COPY --from=golangci/golangci-lint:v2.11.4-alpine@sha256:72bcd68512b4e27540dd3a778a1b7afd45759d8145cfb3c089f1d7af53e718e9 /usr/bin/golangci-lint /usr/local/bin/golangci-lint
COPY --from=gometalinter-downloader /out/ /usr/local/bin/

ENV DAPPER_ENV REPO TAG DRONE_TAG
ENV DAPPER_SOURCE /go/src/github.com/longhorn/upgrade-responder/
ENV DAPPER_OUTPUT ./bin ./dist ./package
ENV DAPPER_DOCKER_SOCKET true
ENV HOME ${DAPPER_SOURCE}
WORKDIR ${DAPPER_SOURCE}

ENTRYPOINT ["./scripts/entry"]
CMD ["ci"]
